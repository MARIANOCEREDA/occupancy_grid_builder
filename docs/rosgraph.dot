digraph occupancy_grid_builder {
  graph [
    label="Occupancy Grid Builder ROS Architecture",
    labelloc=t,
    fontsize=20,
    fontname="Helvetica",
    rankdir=LR,
    compound=true,
    nodesep=0.45,
    ranksep=0.8,
    bgcolor="white"
  ];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  edge [fontname="Helvetica", fontsize=9, color="#666666", arrowsize=0.8];

  subgraph cluster_perception_container {
    label="perception_container (component_container_mt)";
    fontname="Helvetica";
    fontsize=13;
    style="rounded,filled";
    color="#b85450";
    fillcolor="#fce8e6";

    image_undistort [label="image_processing\nimage_undistort_node\nimage_undistort::ImageUndistort"];
    yolo_segmentor [label="yolo_onnx_ros\nyolo_onnx_segmentor_node\nyolo_onnx_ros::YoloSegmentorNode"];
    pcl_labeler [label="pcl_labeler\npcl_labeler_node\npcl_labeler::PCLLabelerNode"];
    kiss_icp [label="kiss_icp\nkiss_icp_node\nkiss_icp_ros::OdometryServer"];
    ground_segmentation [label="ground_segmentation\nground_segmentation::GroundSegmentationNode"];
    occupancy_grid_builder [label="occupancy_grid_builder\noccupancy_grid_builder_node\noccupancy_grid_builder::OccupancyGridBuilderNode"];
    bbox_builder [label="bbox_builder"];
  }

  subgraph cluster_robot_localization {
    label="robot_localization_process";
    fontname="Helvetica";
    fontsize=12;
    style="rounded,filled";
    color="#b85450";
    fillcolor="#fce8e6";

    ekf [label="robot_localization\nekf_filter_node\nekf_node"];
  }

  subgraph cluster_robot_state_publisher {
    label="robot_state_publisher_process";
    fontname="Helvetica";
    fontsize=12;
    style="rounded,filled";
    color="#b85450";
    fillcolor="#fce8e6";

    robot_state_publisher [label="robot_state_publisher\nrobot_state_publisher"];
  }

  camera_driver [label="Camera Driver"];
  lidar_driver [label="Lidar Driver"];
  imu_driver [label="IMU Driver"];
  urdf [shape=note, label="URDF", fillcolor="#fff2cc", color="#d6b656"];
  map_to_odom_broadcaster [label="tf2_ros\nmap_to_odom_broadcaster\nstatic_transform_publisher"];

  image_raw [shape=ellipse, style=filled, label="/image_raw", fillcolor="#fff2cc", color="#d6b656"];
  image_rect [shape=ellipse, style=filled, label="/image_rect", fillcolor="#fff2cc", color="#d6b656"];
  segmentation_mask [shape=ellipse, style=filled, label="/segmentation/mask", fillcolor="#fff2cc", color="#d6b656"];
  lidar_points [shape=ellipse, style=filled, label="/rslidar_points", fillcolor="#fff2cc", color="#d6b656"];
  non_ground_points [shape=ellipse, style=filled, label="/points/non_ground", fillcolor="#fff2cc", color="#d6b656"];
  labeled_points [shape=ellipse, style=filled, label="/points_labeled", fillcolor="#fff2cc", color="#d6b656"];
  kiss_odometry [shape=ellipse, style=filled, label="/kiss/odometry", fillcolor="#fff2cc", color="#d6b656"];
  imu_topic [shape=ellipse, style=filled, label="/imu", fillcolor="#d5e8d4", color="#82b366"];
  boxes [shape=ellipse, style=filled, label="/boxes", fillcolor="#fff2cc", color="#d6b656"];
  occupancy_grid [shape=ellipse, style=filled, label="/occupancy_grid", fillcolor="#fff2cc", color="#d6b656"];
  robot_description [shape=ellipse, style=filled, label="/robot_description", fillcolor="#d5e8d4", color="#82b366"];
  sensor_tf [shape=ellipse, style=filled, label="/tf\nbase_link → imu_link → camera_link → lidar_link", fillcolor="#e1d5e7", color="#9673a6"];
  localization_tf [shape=ellipse, style=filled, label="/tf\nmap → odom → base_link", fillcolor="#e1d5e7", color="#9673a6"];

  // Camera image and segmentation pipeline.
  camera_driver -> image_raw;
  image_raw -> image_undistort;
  image_undistort -> image_rect;
  image_rect -> yolo_segmentor;
  yolo_segmentor -> segmentation_mask;
  segmentation_mask -> pcl_labeler;

  // LiDAR processing, labeling, and outputs.
  lidar_driver -> lidar_points;
  lidar_points -> ground_segmentation;
  ground_segmentation -> non_ground_points;
  non_ground_points -> pcl_labeler;
  pcl_labeler -> labeled_points;
  labeled_points -> bbox_builder;
  labeled_points -> occupancy_grid_builder;
  bbox_builder -> boxes;
  occupancy_grid_builder -> occupancy_grid;

  // Odometry estimation and sensor fusion.
  lidar_points -> kiss_icp;
  kiss_icp -> kiss_odometry;
  kiss_odometry -> ekf;
  imu_driver -> imu_topic;
  imu_topic -> ekf;
  ekf -> localization_tf [label="odom → base_link"];
  map_to_odom_broadcaster -> localization_tf [label="map → odom"];

  // URDF-based fixed transforms and transform consumers.
  urdf -> robot_state_publisher;
  robot_state_publisher -> robot_description;
  robot_state_publisher -> sensor_tf [label="fixed sensor transforms"];
  sensor_tf -> pcl_labeler [label="sensor transforms"];
  localization_tf -> occupancy_grid_builder [label="map/base transforms"];
}
[
    // Editors: cycle tabs when the terminal is not focused
    {
        "key": "ctrl+tab",
        "command": "workbench.action.nextEditor",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+shift+tab",
        "command": "workbench.action.previousEditor",
        "when": "!terminalFocus"
    },
    // Terminals: cycle with the same keys when the terminal is focused
    {
        "key": "ctrl+tab",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+tab",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    // Terminals: jump directly to terminal N
    { "key": "alt+1", "command": "workbench.action.terminal.focusAtIndex1", "when": "terminalFocus" },
    { "key": "alt+2", "command": "workbench.action.terminal.focusAtIndex2", "when": "terminalFocus" },
    { "key": "alt+3", "command": "workbench.action.terminal.focusAtIndex3", "when": "terminalFocus" },
    { "key": "alt+4", "command": "workbench.action.terminal.focusAtIndex4", "when": "terminalFocus" },
    { "key": "alt+5", "command": "workbench.action.terminal.focusAtIndex5", "when": "terminalFocus" }
]
